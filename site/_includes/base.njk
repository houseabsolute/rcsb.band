<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ band.name }}</title>
    <meta name="description" content="{{ band.description }}">
    <meta property="og:title" content="{{ band.name }}">
    <meta property="og:description" content="{{ band.description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ siteUrl }}/">
    {% if band.photo %}<meta property="og:image" content="{{ siteUrl }}{{ band.photo | photo }}">{% endif %}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <div class="rainbow" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    {{ content | safe }}
  </body>
</html>
